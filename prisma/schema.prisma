// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  DESIGNER
  ADMIN
}

enum DesignerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  CANCELLED
}

enum PaymentType {
  ADVANCE
  MILESTONE
  DIGITAL_TWIN_RENEWAL
  DESIGNER_YEARLY_FEE
  CUSTOMER_REGISTRATION_FEE
}

enum NotificationType {
  DESIGNER_APPROVED
  PROJECT_REQUEST
  MILESTONE_SUBMITTED
  MILESTONE_APPROVED
  PAYMENT_RELEASED
}

enum DigitalTwinCategory {
  WIRING
  PLUMBING
  FLOOR_PLAN
  HANDOVER
  OTHER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  sessions         Session[]
  designerProfile  DesignerProfile?
  customerProjects Project[] @relation("CustomerProjects")
  designerProjects Project[] @relation("DesignerProjects")
  notifications    Notification[]
  digitalTwinFiles DigitalTwinFile[] @relation("CustomerDigitalTwinFiles")
  uploadedTwinFiles DigitalTwinFile[] @relation("UploadedDigitalTwinFiles")
  subscriptions    DigitalTwinSubscription[]
  paymentsAsCustomer PaymentLedger[] @relation("CustomerPayments")
  paymentsAsDesigner PaymentLedger[] @relation("DesignerPayments")

  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model DesignerProfile {
  id              String         @id @default(uuid())
  userId          String         @unique
  name            String
  experienceYears Int
  city            String
  pincode         String
  about           String
  status          DesignerStatus @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio DesignerPortfolioFile[]

  @@index([status])
  @@index([city, pincode])
}

model DesignerPortfolioFile {
  id        String   @id @default(uuid())
  profileId String
  blobUrl   String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  profile DesignerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          String        @id @default(uuid())
  customerId  String
  designerId  String
  status      ProjectStatus @default(REQUESTED)
  title       String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  customer User @relation("CustomerProjects", fields: [customerId], references: [id], onDelete: Cascade)
  designer User @relation("DesignerProjects", fields: [designerId], references: [id], onDelete: Cascade)

  milestones     Milestone[]
  payments       PaymentLedger[]
  digitalTwin    DigitalTwinFile[]

  @@index([customerId])
  @@index([designerId])
  @@index([status])
}

model Milestone {
  id          String          @id @default(uuid())
  projectId   String
  title       String
  description String
  amount      Int
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images  MilestoneImage[]
  payments PaymentLedger[]

  @@index([projectId])
  @@index([status])
}

model MilestoneImage {
  id          String   @id @default(uuid())
  milestoneId String
  blobUrl     String
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
}

model PaymentLedger {
  id         String        @id @default(uuid())
  type       PaymentType
  status     PaymentStatus @default(PENDING)
  amount     Int
  currency   String        @default("INR")
  customerId String?
  designerId String?
  projectId  String?
  milestoneId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer  User?     @relation("CustomerPayments", fields: [customerId], references: [id], onDelete: SetNull)
  designer  User?     @relation("DesignerPayments", fields: [designerId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([projectId])
  @@index([customerId])
}

model DigitalTwinFile {
  id          String             @id @default(uuid())
  customerId  String
  projectId   String?
  category    DigitalTwinCategory @default(OTHER)
  blobUrl     String
  fileName    String
  mimeType    String
  sizeBytes   Int
  uploadedBy  String
  createdAt   DateTime           @default(now())

  customer User   @relation("CustomerDigitalTwinFiles", fields: [customerId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader User   @relation("UploadedDigitalTwinFiles", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([projectId])
}

model DigitalTwinSubscription {
  id         String             @id @default(uuid())
  customerId String
  status     SubscriptionStatus @default(ACTIVE)
  startedAt  DateTime           @default(now())
  expiresAt  DateTime
  lastChargedAt DateTime?

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId])
  @@index([expiresAt])
}

model AdminSettings {
  id                     String   @id @default(uuid())
  otpEnabled             Boolean  @default(false)
  customerRegistrationFee Int      @default(0)
  designerYearlyFee      Int      @default(0)
  digitalTwinYearlyFee   Int      @default(1000)
  smtpHost               String?
  smtpPort               Int?
  smtpUser               String?
  smtpPass               String?
  smtpSecure             Boolean? @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  socialLinks SocialLink[]
  marketingLinks MarketingLink[]
  rates       CityPincodeRate[]
}

model SocialLink {
  id           String   @id @default(uuid())
  settingsId   String
  platform     String
  url          String
  showInHeader Boolean @default(true)
  showInFooter Boolean @default(true)
  showInLanding Boolean @default(true)

  settings AdminSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId])
}

model MarketingLink {
  id           String   @id @default(uuid())
  settingsId   String
  label        String
  url          String
  showInHeader Boolean @default(true)
  showInFooter Boolean @default(true)
  showInLanding Boolean @default(true)

  settings AdminSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([settingsId])
}

model CityPincodeRate {
  id         String   @id @default(uuid())
  settingsId String
  city       String
  pincode    String
  ratePerSqFt Int
  isActive   Boolean  @default(true)

  settings AdminSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@index([city, pincode])
  @@index([settingsId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}
